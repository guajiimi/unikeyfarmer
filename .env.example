# ===== UNIKEY FARMER CONFIG =====
# Capsolver API key (https://capsolver.com) — untuk solve Turnstile
CAPSOLVER_KEY=your_capsolver_key_here

# Turnstile sitekey (dari GET /api/status — default UNIKEY)
TURNSTILE_SITEKEY=0x4AAAAAAD83S5lYamgIOFL4

# Target
BASE_URL=https://www.getunikey.ai
API_BASE_URL=https://www.getunikey.ai/v1

# Model untuk precheck API key (pilih yang cepat/murah)
PRECHECK_MODEL=google/gemini-3.1-flash-lite

# Proxy list file (1 per line, http/socks5, atau "direct")
PROXY_FILE=proxy.txt

# Output
ACCOUNTS_FILE=output/accounts.json
